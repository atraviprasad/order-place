{
  "realm": "orderplace",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@orderplace.local",
    "fromDisplayName": "Order Place",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "ADMIN"
      },
      {
        "name": "CUSTOMER"
      },
      {
        "name": "DEALER"
      }
    ]
  },
  "clients": [
    {
      "clientId": "orderplace-web",
      "name": "Order Place Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "org_type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_type",
            "claim.name": "org_type",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "orderplace-dev-test",
      "name": "DEV ONLY: token testing with curl/Postman",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "org_type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_type",
            "claim.name": "org_type",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "orderplace-user-service",
      "name": "User Service (Keycloak admin calls)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-user-service-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-orderplace-user-service",
      "enabled": true,
      "serviceAccountClientId": "orderplace-user-service",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    },
    {
      "username": "admin1",
      "email": "admin1@orderplace.local",
      "firstName": "Admin",
      "lastName": "One",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "ADMIN"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "Admin@123",
          "temporary": false
        }
      ]
    },
    {
      "username": "dealer1",
      "email": "dealer1@orderplace.local",
      "firstName": "Dealer",
      "lastName": "One",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "DEALER"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "Dealer@123",
          "temporary": false
        }
      ],
      "attributes": {
        "org_id": [
          "22222222-2222-2222-2222-222222222222"
        ],
        "org_type": [
          "DEALER"
        ]
      }
    },
    {
      "username": "customer1",
      "email": "customer1@orderplace.local",
      "firstName": "Customer",
      "lastName": "One",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "CUSTOMER"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "Customer@123",
          "temporary": false
        }
      ],
      "attributes": {
        "org_id": [
          "11111111-1111-1111-1111-111111111111"
        ],
        "org_type": [
          "CUSTOMER"
        ]
      }
    }
  ]
}